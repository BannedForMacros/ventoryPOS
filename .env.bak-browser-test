# Facturación electrónica SUNAT vía FacturaMac (ver config/facturamac.php).
#
# Aquí SOLO se configura cómo llegar a FacturaMac. Las series, la tasa de IGV,
# el umbral de boleta identificada, el catálogo de unidades SUNAT y el modo de
# emisión (desactivado/simulacion/beta/produccion) se configuran EN FACTURAMAC
# y este POS los consulta por GET /api/v1/configuracion. No los dupliques aquí:
# si los dos sistemas discrepan, el comprobante sale mal y en silencio.
#
# FACTURAMAC_ENABLED = "¿está cableada la integración?" (hay URL y token).
# En false el POS funciona como hoy, sin emitir nada y sin llamadas de red.
# El interruptor de negocio "¿emitimos a SUNAT?" vive en FacturaMac.
FACTURAMAC_ENABLED=false
FACTURAMAC_URL=http://localhost:8001
FACTURAMAC_TOKEN=
FACTURAMAC_TIMEOUT=20
# Segundos de caché de la configuración remota (y de espera tras un fallo).
FACTURAMAC_CONFIG_TTL=600
FACTURAMAC_CONFIG_COOLDOWN=30
