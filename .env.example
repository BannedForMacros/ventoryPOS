APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DECOLECTA_TOKEN=tu_token_aqui
DECOLECTA_BASE_URL=https://api.decolecta.com


# Facturación electrónica SUNAT vía FacturaMac (ver config/facturamac.php).
#
# Aquí SOLO se configura cómo llegar a FacturaMac. Las series, la tasa de IGV,
# el umbral de boleta identificada, el catálogo de unidades SUNAT y el modo de
# emisión (desactivado/simulacion/beta/produccion) se configuran EN FACTURAMAC
# y este POS los consulta por GET /api/v1/configuracion. No los dupliques aquí:
# si los dos sistemas discrepan, el comprobante sale mal y en silencio.
#
# OJO — FACTURAMAC_ENABLED y FACTURAMAC_TOKEN YA NO EXISTEN. Se fueron a la base
# de datos, a `facturacion_conexiones`, UNA FILA POR EMPRESA, y se gestionan por
# interfaz en Configuración → Facturación Electrónica.
#
# POR QUÉ: un token de FacturaMac identifica a UNA empresa emisora (de él salen el
# RUC, el certificado y la clave SOL). El `.env` es uno solo para toda la
# instalación, y esta instalación sirve a dos contribuyentes distintos. Con un
# único token, las ventas del segundo salían firmadas con el RUC del primero:
# facturar a nombre de otro contribuyente. No era arreglable aquí, porque no hay
# dónde poner el segundo token.
#
# FACTURAMAC_URL sí se queda: FacturaMac es un único servicio para toda la
# instalación, y esto es "a qué máquina se llama", no de quién es la cuenta.
FACTURAMAC_URL=http://localhost:8001
FACTURAMAC_TIMEOUT=20
# Segundos de caché de la configuración remota (y de espera tras un fallo).
FACTURAMAC_CONFIG_TTL=600
FACTURAMAC_CONFIG_COOLDOWN=30
